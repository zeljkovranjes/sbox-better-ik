<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Separate from BetterIk.Tests (net8.0) because Sandbox.System.dll is built against .NET 10:
    referencing it from a net8.0 project fails with CS1705 (System.Runtime version mismatch).
    This project only needs Sandbox.System.dll (plain math types, no engine/editor dependency),
    confirmed working standalone with no s&box editor process running.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="D:/SteamLibrary/steamapps/common/sbox/bin/managed/Sandbox.System.dll" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Code\BetterIk\MathBridge.cs" />
    <Compile Include="MathBridgeTests.cs" />
  </ItemGroup>

</Project>
